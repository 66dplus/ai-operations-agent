# Offline Compose runs immediately. Live mode is opt-in after runtime verification.
APP_PORT=3100
APP_ORIGIN=http://localhost:3100
POSTGRES_PASSWORD=local-development-only
# Native development only (Compose sets its internal connection):
DATABASE_URL=dbname=ai_operations_local
# Never enable paid fallback in OpenCode Go.
GO_BALANCE_DISABLED=false
LIVE_ENABLED=false
RUNTIME_VERIFIED=false
# Native live gateway only; paths contain credentials and are never given to OpenCode:
GO_KEY_FILE=
FIRECRAWL_KEY_FILE=
MAX_MODEL_CALLS=100
MAX_FIRECRAWL_CREDITS=250
BUDGET_SCOPE=acceptance
